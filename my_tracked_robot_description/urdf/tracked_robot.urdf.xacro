<?xml version="1.0"?>
<!-- IMPORTANT: The name is kept as "tracked_robot" to match your launch files. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracked_robot">

    <!-- #################### PROPERTIES #################### -->
    <xacro:property name="PI" value="3.1415926535897931"/>
    
    <!-- Chassis Properties -->
    <xacro:property name="chassis_length" value="0.5"/>
    <xacro:property name="chassis_width" value="0.3"/>
    <xacro:property name="chassis_height" value="0.15"/>
    <xacro:property name="chassis_mass" value="5.0"/>

    <!-- Wheel Properties -->
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_width" value="0.05"/>
    <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="wheel_separation" value="0.25"/>
    <xacro:property name="wheel_x_offset" value="-0.2"/>
    <xacro:property name="wheel_z_offset" value="-0.05"/>

    <!-- Caster Properties -->
    <xacro:property name="caster_radius" value="0.05"/>
    <xacro:property name="caster_mass" value="0.1"/>
    <xacro:property name="caster_x_offset" value="0.2"/>
    <xacro:property name="caster_z_offset" value="-0.1"/>

    <!-- 2D Lidar Properties (Original) -->
    <xacro:property name="lidar_2d_radius" value="0.1"/>
    <xacro:property name="lidar_2d_length" value="0.05"/>
    <xacro:property name="lidar_2d_mass" value="0.2"/>
    <xacro:property name="lidar_z_offset" value="0.1"/>

    <!-- SICK multiScan136 3D Lidar Properties (New) -->
    <xacro:property name="lidar_3d_radius" value="0.05015"/> <!-- 100.3mm diameter / 2 -->
    <xacro:property name="lidar_3d_length" value="0.0985"/>  <!-- 98.5mm height -->
    <xacro:property name="lidar_3d_mass" value="0.7"/>       <!-- 0.7 kg -->

    <!-- RGB Camera Properties -->
    <xacro:property name="camera_width" value="0.05"/>
    <xacro:property name="camera_height" value="0.05"/>
    <xacro:property name="camera_depth" value="0.02"/>
    <xacro:property name="camera_mass" value="0.1"/>
    <xacro:property name="camera_x_offset" value="0.2"/>
    <xacro:property name="camera_y_offset" value="0"/>
    <xacro:property name="camera_z_offset" value="0.1"/>

    <!-- #################### ROBOT LINKS AND JOINTS #################### -->
    <!-- NEW: This is the new root link at the front edge of the robot. -->
<!-- It has no visual or collision properties because it's just a reference frame. -->
    <link name="base_footprint"/>
    <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="-${chassis_length / 2.0} 0 0" rpy="0 0 0"/>
    </joint>
    
    <link name="base_link">
        <visual>
            <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
            <material name="blue"><color rgba="0 0 0.8 1"/></material>
        </visual>
        <collision>
            <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
        </collision>
        <inertial>
            <mass value="${chassis_mass}"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>

    <xacro:macro name="wheel" params="side side_y_reflect">
        <link name="${side}_wheel_link">
            <visual>
                <origin rpy="${PI/2} 0 0" xyz="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="black"><color rgba="0 0 0 1"/></material>
            </visual>
            <collision>
                <origin rpy="${PI/2} 0 0" xyz="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <inertial>
                <mass value="${wheel_mass}"/>
                <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
            </inertial>
        </link>

        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${side}_wheel_link"/>
            <origin rpy="0 0 0" xyz="${wheel_x_offset} ${side_y_reflect * wheel_separation/2} ${wheel_z_offset}"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel side="left"  side_y_reflect="1"/>
    <xacro:wheel side="right" side_y_reflect="-1"/>

    <link name="caster_wheel_link">
        <visual><geometry><sphere radius="${caster_radius}"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
        <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
        <inertial>
            <mass value="${caster_mass}"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="caster_wheel_joint" type="fixed"><parent link="base_link"/><child link="caster_wheel_link"/><origin xyz="${caster_x_offset} 0 ${caster_z_offset}"/></joint>

    <!-- 2D LiDAR Link (Original, Renamed) -->
    <link name="lidar_2d_link">
        <visual><geometry><cylinder length="${lidar_2d_length}" radius="${lidar_2d_radius}"/></geometry><material name="green"><color rgba="0 1 0 1"/></material></visual>
        <!-- COLLISION REMOVED to prevent interference with the co-located 3D LiDAR -->
        <inertial>
            <mass value="${lidar_2d_mass}"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="lidar_2d_joint" type="fixed"><parent link="base_link"/><child link="lidar_2d_link"/><origin xyz="0.15 0 ${lidar_z_offset}"/></joint>

    <!-- 3D LiDAR Link (New) -->
    <link name="lidar_3d_link">
        <visual><geometry><cylinder length="${lidar_3d_length}" radius="${lidar_3d_radius}"/></geometry><material name="red"><color rgba="1 0 0 1"/></material></visual>
        <!-- COLLISION REMOVED to prevent interference with the co-located 2D LiDAR -->
        <inertial>
            <mass value="${lidar_3d_mass}"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="lidar_3d_joint" type="fixed"><parent link="base_link"/><child link="lidar_3d_link"/><origin xyz="0.20 0 ${lidar_z_offset}"/></joint>
    
    <!-- RGB Camera Link -->
    <link name="camera_link">
        <visual>
            <geometry><box size="${camera_width} ${camera_height} ${camera_depth}"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <inertial>
            <mass value="${camera_mass}"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="${camera_x_offset} ${camera_y_offset} ${camera_z_offset}" rpy="0 0 0"/>
    </joint>

        <!-- ########### NEW: REAR CAMERA ########### -->
    <!-- RGB Camera Link (Rear) -->
    <link name="camera_rear_link">
        <visual>
            <geometry><box size="${camera_width} ${camera_height} ${camera_depth}"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
        <inertial>
            <mass value="${camera_mass}"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>
    <joint name="camera_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_rear_link"/>
        <!-- Positioned at the back (-x) and rotated 180 deg (PI rad) around Z to face backward -->
        <origin xyz="-0.2 ${camera_y_offset} ${camera_z_offset}" rpy="0 0 ${PI}"/>
    </joint>
    <!-- ########################################## -->
    <!-- #################### GAZEBO PLUGINS AND REFERENCES #################### -->
    
    <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="left_wheel_link"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="right_wheel_link"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="lidar_2d_link"><material>Gazebo/Green</material></gazebo>
    <gazebo reference="lidar_3d_link"><material>Gazebo/Red</material></gazebo> <!-- Material for new 3D LiDAR -->
    <gazebo reference="caster_wheel_link"><material>Gazebo/Black</material><mu1>0.1</mu1><mu2>0.1</mu2></gazebo>

    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <ros><remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom</remapping></ros>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_diameter>${2*wheel_radius}</wheel_diameter>
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
        </plugin>
    </gazebo>

    <!-- Gazebo Plugin for 2D LiDAR -->
    <gazebo reference="lidar_2d_link">
        <sensor name="lidar_2d_sensor" type="ray">
            <visualize>false</visualize><update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal><samples>360</samples><min_angle>-${PI}</min_angle><max_angle>${PI}</max_angle></horizontal>
                </scan>
                <range><min>0.14</min><max>2.0</max></range>
            </ray>
            <plugin name="lidar_2d_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros><remapping>~/out:=scan</remapping></ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_2d_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Gazebo Plugin for SICK multiScan136 3D LiDAR -->
    <gazebo reference="lidar_3d_link">
        <sensor name="lidar_3d_sensor" type="ray">
            <visualize>false</visualize>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-${1.75}</min_angle>
                        <max_angle>${1.75}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>14</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.7417</min_angle> <!-- -42.5 degrees -->
                        <max_angle>0.3927</max_angle>  <!-- 22.5 degrees -->
                    </vertical>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>2.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="lidar_3d_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros><remapping>~/out:=points</remapping></ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>lidar_3d_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
        <sensor type="depth" name="front_rgbd_camera">
            <update_rate>30.0</update_rate>
            <camera name="head">
                <!-- 130 degrees in radians -->
                <horizontal_fov>2.2689</horizontal_fov>
                <image>
                    <!-- You can adjust the resolution as needed -->
                    <width>1024</width>
                    <height>576</height>
                </image>
                <clip>
                    <!-- Adjust near and far clipping planes for your application -->
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <!-- Topics will be namespaced under /tracked_robot/front_rgbd_camera/ -->
                    <namespace>/tracked_robot</namespace>
                    <remapping>image_raw:=rgb/image_raw</remapping>
                    <remapping>camera_info:=rgb/camera_info</remapping>
      
                    <remapping>depth/camera_info:=depth/camera_info</remapping>
                </ros>

                <!-- A unique camera name to namespace the topics -->
                <camera_name>front_rgbd_camera</camera_name>
                <frame_name>camera_link</frame_name>

                <!-- Set to true to publish the depth image -->
                <publish_depth_image>true</publish_depth_image>
                <depth_image_topic_name>depth/image_raw</depth_image_topic_name>
                <depth_info_topic_name>depth/camera_info</depth_info_topic_name>

                <!-- Set to false to disable the point cloud -->
                <publish_point_cloud>false</publish_point_cloud>

                <!-- Clipping values for the depth data -->
                <point_cloud_cutoff>0.1</point_cloud_cutoff>
                <point_cloud_cutoff_max>10.0</point_cloud_cutoff_max>
            </plugin>
        </sensor>
    </gazebo>
        <!-- ########### NEW: GAZEBO PLUGIN FOR REAR CAMERA ########### -->
    <gazebo reference="camera_rear_link">
        <material>Gazebo/Grey</material>
        <sensor type="camera" name="rgb_camera_rear">
            <update_rate>30.0</update_rate>
            <camera name="rear_head">
                <!-- 100 degrees in radians = 1.7453 -->
                <horizontal_fov>1.7453</horizontal_fov>
                <image>
                    <width>1024</width>
                    <height>576</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.28</near>
                    <far>16.0</far>
                </clip>
            </camera>
            <plugin name="camera_rear_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/tracked_robot</namespace>
                    <remapping>image_raw:=image_raw</remapping>
                    <remapping>camera_info:=camera_info</remapping>
                </ros>
                <!-- This unique camera_name ensures a unique topic: /tracked_robot/rear_camera/image_raw -->
                <camera_name>rear_camera</camera_name>
                <frame_name>camera_rear_link</frame_name>
                <hack_baseline>0.07</hack_baseline>
            </plugin>
        </sensor>
    </gazebo>
    <!-- ########################################################## -->
</robot>