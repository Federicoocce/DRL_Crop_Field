<?xml version="1.0" ?>
<sdf version="1.6">
  <model name='maize_detailed_0246'>
    <!-- 1. Matched top-level pose from maize_01.sdf -->
    <pose frame=''>0 0 0.05 0 -0 0</pose>

    <!-- Renamed link for clarity -->
    <link name='maize_detailed_0246_link'>
      
      <!-- 2. Copied inertial properties from maize_01.sdf -->
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0033416667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0033416667</iyy>
          <iyz>0</iyz>
          <izz>0.000016666667</izz>
        </inertia>
        <!-- Note: original had two pose tags in inertial, which is invalid SDF. Using one. -->
        <pose>0 0 0.1 0 0 0</pose> 
      </inertial>

      <!-- 3. THIS IS OUR CRITICAL CHANGE: Using the mesh for collision -->
      <collision name='collision'>
        <!-- THIS POSE SHIFTS THE COLLISION MESH UP BY 10 METERS -->
        <pose>0 0 0.0 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://maize_detailed_0246/meshes/0001.stl</uri>
            <scale>0.683166466464586 0.683166466464586 0.683166466464586</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name='visual'>
        <!-- THIS POSE SHIFTS THE VISUAL MESH UP BY 20 METERS -->
        <pose>0 0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://maize_detailed_0246/meshes/0001.stl</uri>
            <scale>0.683166466464586 0.683166466464586 0.683166466464586</scale>
          </mesh>
        </geometry>
        <material>
            <ambient>0.2 0.4 0.1 1.0</ambient>
            <diffuse>0.3 0.6 0.2 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <emissive>0 0 0 1</emissive>
        </material>
      </visual>

    </link>
  </model>
</sdf>